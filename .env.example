# Prisma connection string. Local SQLite is free and needs no account. https://www.prisma.io/docs/orm/overview/databases/sqlite (checked 2026-11-22).
DATABASE_URL="file:./dev.db"
# Optional canonical HTTPS origin for a reverse proxy. Use your own deployment URL. No API key. https://nextjs.org/docs/app/guides/self-hosting (checked 2026-11-22).
APP_ORIGIN=""
# Enable Secure session cookies in HTTPS production. Local HTTP development uses false. No service or API key. https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Set-Cookie (checked 2026-11-22).
COOKIE_SECURE="false"
# Shared Linux tessdata path if Tesseract does not find eng and chi_tra. Local and free. https://tesseract-ocr.github.io/tessdoc/Installation.html (checked 2026-11-22).
# TESSDATA_PREFIX="/usr/share/tesseract-ocr/5/tessdata"
# Optional local Ollama HTTP origin. Install and run Ollama; local inference is free, no API key. https://docs.ollama.com/api/introduction (checked 2026-11-22).
OLLAMA_URL=""
# Optional model tag, e.g. qwen2.5:7b from ollama pull. Local weights, no paid plan required. https://ollama.com/library/qwen2.5 (checked 2026-11-22).
OLLAMA_MODEL=""
# Generate a VAPID key pair with npx web-push generate-vapid-keys. Free local generation, no provider signup. https://github.com/web-push-libs/web-push#usage (checked 2026-11-22).
VAPID_PUBLIC_KEY=""
# Private half of the key generated above. Keep server-only. Free local generation. https://github.com/web-push-libs/web-push#usage (checked 2026-11-22).
VAPID_PRIVATE_KEY=""
# Valid mailto: operator address or HTTPS contact URL for VAPID. No provider charge. https://datatracker.ietf.org/doc/html/rfc8292 (checked 2026-11-22).
VAPID_SUBJECT=""
# Optional disable Next.js framework telemetry. Local setting and no service key. https://nextjs.org/telemetry (checked 2026-11-22).
NEXT_TELEMETRY_DISABLED="1"
# Optional use host-standard HTTP(S)_PROXY and NO_PROXY for Node egress. Free local Node setting. https://nodejs.org/api/cli.html#node_use_env_proxy1 (checked 2026-11-22).
# NODE_USE_ENV_PROXY=1
# Optional Playwright application origin. A local test server is free. https://playwright.dev/docs/test-configuration (checked 2026-11-22).
# HK_TEST_URL=http://127.0.0.1:4380
# Optional second test origin with all optional integrations unset. Local and free. https://playwright.dev/docs/test-configuration (checked 2026-11-22).
# HK_SETUP_URL=http://127.0.0.1:4381
# Optional test origin with Tesseract available and Ollama unset. Local and free. https://playwright.dev/docs/test-configuration (checked 2026-11-22).
# HK_OCR_ONLY_URL=http://127.0.0.1:4382
# Optional path to a local Chromium binary for tests. Otherwise use the free Playwright browser download. https://playwright.dev/docs/browsers (checked 2026-11-22).
# CHROMIUM_PATH=/usr/bin/chromium
